<Window x:Class="AmneziaVPN.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SELFVPS — установка"
        Height="520" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="14"
            Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Stroke}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Opacity="0.58" ShadowDepth="0" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
                <Grid Background="Transparent" MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <TextBlock Text="SELF" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="VPS" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="SemiBold"/>
                        <Border Margin="14,0,0,0" Padding="9,4" Background="{StaticResource BgPanel2}"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12">
                            <TextBlock x:Name="VersionTag" Text="v0.0.0" Foreground="{StaticResource TextDim}"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Установка VPN-клиента" Foreground="{StaticResource TextDim}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,14,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" Content="&#xE921;"/>
                        <Button Style="{StaticResource CaptionButtonClose}" Click="Close_Click" Content="&#xE8BB;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="36,22,36,18">
                <StackPanel x:Name="ScreenReady" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Готов к установке"
                               Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="Будут установлены клиент, Windows-сервис и сетевые компоненты AmneziaVPN. Для выполнения потребуется подтверждение UAC."
                               Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap"
                               LineHeight="20" Margin="0,8,0,18"/>

                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1" CornerRadius="10" Padding="16,13">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Путь" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="InstallPathText" Foreground="{StaticResource Text}"
                                           FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Компоненты" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="InfoComponentsText"
                                           Text="Клиент, служба, сетевой драйвер и протоколы."
                                           Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Доступ" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <TextBlock Grid.Column="1" x:Name="InfoRightsText" Text="Потребуются права администратора."
                                           Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="2,15,0,0">
                        <CheckBox x:Name="ChkStartMenu" Margin="0,0,26,0" Foreground="{StaticResource TextDim}" IsChecked="True">
                            <TextBlock Text="Ярлык в меню Пуск" FontSize="12"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkDesktop" Foreground="{StaticResource TextDim}" IsChecked="True">
                            <TextBlock Text="Ярлык на рабочем столе" FontSize="12"/>
                        </CheckBox>
                    </WrapPanel>
                    <CheckBox x:Name="ChkCleanInstall" Margin="2,9,0,0" Foreground="{StaticResource TextDim}" Visibility="Collapsed">
                        <TextBlock Text="Очистить локальные данные перед установкой" FontSize="12"/>
                    </CheckBox>
                    <TextBlock x:Name="CleanInstallDescription" Margin="24,5,0,0" Foreground="#F0B45E"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Будут удалены локальные настройки, логи и автозапуск текущего пользователя."/>
                </StackPanel>

                <StackPanel x:Name="ScreenProgress" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,18"
                            Background="#172C48" CornerRadius="22">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}"
                                   FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Выполняем установку" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProgressStatus" Text="Подготовка..." Foreground="{StaticResource TextDim}"
                               FontSize="13" Margin="0,8,0,25"/>
                    <ProgressBar x:Name="ProgressBar" Value="0" Maximum="100"/>
                </StackPanel>

                <StackPanel x:Name="ScreenDone" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <Ellipse Fill="{StaticResource Success}" Opacity="0.16"/>
                        <Path Stretch="Uniform" Width="25" Height="25" Stroke="{StaticResource Success}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5 12 L10 17 L19 7"/>
                    </Grid>
                    <TextBlock x:Name="DoneTitle" Text="Готово" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DoneSubtitle" Text="AmneziaVPN установлен. Сервис и ярлыки зарегистрированы."
                               Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap"
                               LineHeight="20" Margin="0,8,0,0"/>
                    <CheckBox x:Name="ChkLaunchAfterInstall" Margin="2,18,0,0" Foreground="{StaticResource TextDim}" IsChecked="True">
                        <TextBlock Text="Запустить AmneziaVPN после закрытия установщика" FontSize="12"/>
                    </CheckBox>
                </StackPanel>

                <StackPanel x:Name="ScreenError" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <Ellipse Fill="{StaticResource Danger}" Opacity="0.16"/>
                        <Path Stretch="Uniform" Width="25" Height="25" Stroke="{StaticResource Danger}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6 6 L18 18 M18 6 L6 18"/>
                    </Grid>
                    <TextBlock Text="Установка не завершена" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorMessage" Text="" Foreground="{StaticResource TextDim}" FontSize="13"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnSecondary" Grid.Column="0" HorizontalAlignment="Left"
                            Style="{StaticResource GhostButton}" Content="Отмена" Click="Secondary_Click"/>
                    <Button x:Name="BtnPrimary" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}" Content="Установить" MinWidth="156" Click="Primary_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
